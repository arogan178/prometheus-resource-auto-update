# Bitbucket Authentication (Choose one pair)
BITBUCKET_EMAIL=you@example.com
BITBUCKET_API_TOKEN=your_token_here
# BITBUCKET_USERNAME=your_username
# BITBUCKET_APP_PASSWORD=your_app_password

# Organization Settings
BITBUCKET_WORKSPACE=my-company-workspace
REPO_PREFIX=

# Branch configuration
RESOURCE_UPDATE_BRANCH=resource-update

# Kustomize Paths.
# Point this at either one kustomize repo or a directory containing many repos.
KUSTOMIZE_REPOS_DIR=/path/to/kustomize-repos
KUSTOMIZE_MONOREPO_NAME=my-kustomize-repo
CLUSTER_CONFIG=/path/to/cluster-config-repo

# Cluster Mapping
# Example: {"dev": "cluster-1", "prd": "cluster-2"}
CLUSTER_MAPPING={"dev": "dev-cluster", "stg": "stg-cluster", "prd": "prd-cluster"}

# Optional namespace filtering. Leave empty to scan every accessible namespace.
NAMESPACE_INCLUDE_REGEX=

# Optional cluster-config applications file template.
CLUSTER_CONFIG_APPS_TEMPLATE=namespaces/{cluster}/{namespace}/applications/kustomization.yaml

# Thresholds
AUTO_MERGE_CPU_THRESHOLD=1
AUTO_MERGE_MEMORY_THRESHOLD=4Gi
CPU_REQUEST_TARGET_FACTOR=0.95
MEMORY_REQUEST_TARGET_FACTOR=1.15
CPU_LIMIT_BUFFER_FACTOR=1.20
MEMORY_LIMIT_BUFFER_FACTOR=1.20

# Optional repository name normalization.
REPO_NAME_PREFIXES=
REPO_ALIAS_PREFIXES=

# Impact Filtering (Ignore small changes)
MIN_CPU_DIFF_MILLIS=50
MIN_MEM_DIFF_MI=128

# Smart Rollouts
WAIT_FOR_ROLLOUT=true
ROLLOUT_TIMEOUT=5m
